// ─────────────────────────────────────────────────────────────────────────────
//  Royal Design Studio — Complete Prisma Schema
//  Database: PostgreSQL 15
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  BILLING_STAFF
  ORDER_MANAGER
  DESIGNER
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum ProformaStatus {
  DRAFT
  SENT
  EXPIRED
  CANCELLED
  CONVERTED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}

enum OrderStatus {
  NEW
  AWAITING_ARTWORK
  AWAITING_APPROVAL
  APPROVED
  IN_PRODUCTION
  QUALITY_CHECK
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  CLOSED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  READY_FOR_DISPATCH
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  DELIVERY_FAILED
  RETURNED
}

enum RecurringFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum RecurringPlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum DocumentType {
  INVOICE
  QUOTATION
  PROFORMA
  RECEIPT
  ORDER
  EXPENSE
}

enum ExpenseCategory {
  PRINTING_MATERIALS
  GIFT_PROCUREMENT
  PACKAGING
  DELIVERY_COURIER
  FREELANCERS
  SOFTWARE_SUBSCRIPTIONS
  ADVERTISING_MARKETING
  OFFICE_EXPENSES
  EQUIPMENT
  OTHER
}

enum ProductCategory {
  DIGITAL_MARKETING
  GIFTING_CUSTOMIZED
  PRINTING
  GRAPHIC_DESIGN_BRANDING
  WEBSITE_DEVELOPMENT
  OTHER
}

enum AttachmentEntityType {
  ORDER
  EXPENSE
  INVOICE
  QUOTATION
  PROFORMA
  DELIVERY
  CUSTOMER
  COMPANY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  INVOICE_ISSUE
  INVOICE_CANCEL
  PAYMENT_RECORD
  PAYMENT_ALLOCATE
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPANY & USERS
// ─────────────────────────────────────────────────────────────────────────────

model CompanySettings {
  id                    String  @id @default(cuid())
  name                  String  @default("Royal Design Studio")
  addressLine1          String  @default("2/33-20, Sandhanakumarpatti")
  addressLine2          String  @default("Mayalappapuram Road, Avudayanoor")
  city                  String  @default("Avudayanoor")
  state                 String  @default("Tamil Nadu")
  pincode               String  @default("627808")
  country               String  @default("India")
  phone                 String  @default("+91 93859 31697")
  whatsapp              String  @default("+91 93859 31697")
  email                 String  @default("royaldesignstudioofficial@gmail.com")
  website               String?
  logoPath              String? // path to uploaded logo file
  brandColorPrimary     String  @default("#1a56db")
  brandColorSecondary   String  @default("#6875f5")
  // Tax
  isGstRegistered       Boolean @default(false)
  gstin                 String?
  // Invoice settings
  invoicePrefix         String  @default("RDS")
  invoiceTypeCode       String  @default("INV")
  quotationTypeCode     String  @default("QTN")
  proformaTypeCode      String  @default("PI")
  receiptTypeCode       String  @default("REC")
  orderTypeCode         String  @default("ORD")
  sequenceSeparator     String  @default("/")
  sequencePadLength     Int     @default(4)
  financialYearStart    Int     @default(4) // April = 4
  // Terms
  defaultInvoiceTerms   String?
  defaultQuotationTerms String?
  paymentInstructions   String?
  // Currency
  currency              String  @default("INR")
  currencySymbol        String  @default("₹")
  timezone              String  @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(BILLING_STAFF)
  status       UserStatus @default(ACTIVE)
  avatarPath   String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  createdInvoices      SalesInvoice[]     @relation("InvoiceCreator")
  createdQuotations    Quotation[]        @relation("QuotationCreator")
  createdProformas     ProformaInvoice[]  @relation("ProformaCreator")
  createdPayments      Payment[]          @relation("PaymentCreator")
  createdOrders        Order[]            @relation("OrderCreator")
  orderStatusUpdates   OrderStatusHistory[]
  auditLogs            AuditLog[]
  createdExpenses      Expense[]          @relation("ExpenseCreator")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
//  DOCUMENT SEQUENCES (Concurrency-Safe Numbering)
// ─────────────────────────────────────────────────────────────────────────────

model DocumentSequence {
  id            String       @id @default(cuid())
  documentType  DocumentType
  financialYear String       // e.g. "2026-27"
  lastNumber    Int          @default(0)
  resetOnYear   Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([documentType, financialYear])
  @@map("document_sequences")
}

// ─────────────────────────────────────────────────────────────────────────────
//  CUSTOMERS
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id              String   @id @default(cuid())
  name            String   // company or individual name
  contactPerson   String?
  phone           String
  whatsapp        String?
  email           String?
  // Billing address
  billingAddress  String?
  billingCity     String?
  billingState    String?
  billingPincode  String?
  // Delivery address
  deliveryAddress String?
  deliveryCity    String?
  deliveryState   String?
  deliveryPincode String?
  // Tax
  gstin           String?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  quotations       Quotation[]
  proformas        ProformaInvoice[]
  invoices         SalesInvoice[]
  payments         Payment[]
  orders           Order[]
  recurringPlans   RecurringPlan[]
  deliveries       Delivery[]
  attachments      Attachment[]

  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────────
//  PRODUCTS & SERVICES CATALOG
// ─────────────────────────────────────────────────────────────────────────────

model ProductService {
  id           String          @id @default(cuid())
  sku          String?         @unique
  name         String
  category       ProductCategory
  customCategory String?         // Dynamic user-defined category name
  subCategory    String?         // Material or variant, e.g. "100% Cotton 180 GSM", "Star Backlit Flex", etc.
  imageUrl       String?         // Product image preview path
  pdfUrl         String?         // Product brochure / specsheet PDF path
  description    String?
  unit         String          @default("pcs") // pcs, hrs, job, set, etc.
  sellingPrice Decimal         @db.Decimal(12, 2)
  wholesalePrice Decimal?      @db.Decimal(12, 2)
  costPrice    Decimal?        @db.Decimal(12, 2)
  taxRate      Decimal         @default(0) @db.Decimal(5, 2) // % – 0 until GST enabled
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  quotationItems    QuotationItem[]
  proformaItems     ProformaItem[]
  invoiceItems      InvoiceItem[]
  orderItems        OrderItem[]

  @@map("product_services")
}

// ─────────────────────────────────────────────────────────────────────────────
//  QUOTATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Quotation {
  id             String          @id @default(cuid())
  number         String          @unique // RDS/QTN/2026-27/0001
  customerId     String
  createdById    String
  issueDate      DateTime
  validUntil     DateTime
  status         QuotationStatus @default(DRAFT)
  // Totals
  subtotal       Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  // Content
  notes          String?
  terms          String?
  // Tracking
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  customer        Customer          @relation(fields: [customerId], references: [id])
  createdBy       User              @relation("QuotationCreator", fields: [createdById], references: [id])
  items           QuotationItem[]
  proformas       ProformaInvoice[] @relation("QuotationProformas")
  invoices        SalesInvoice[]    @relation("QuotationInvoices")
  orders          Order[]           @relation("QuotationOrders")

  @@map("quotations")
}

model QuotationItem {
  id             String  @id @default(cuid())
  quotationId    String
  productId      String?
  description    String
  unit           String  @default("pcs")
  quantity       Decimal @db.Decimal(10, 3)
  unitPrice      Decimal @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  lineTotal      Decimal @db.Decimal(12, 2)
  sortOrder      Int     @default(0)

  quotation Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   ProductService? @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

// ─────────────────────────────────────────────────────────────────────────────
//  PROFORMA INVOICES
// ─────────────────────────────────────────────────────────────────────────────

model ProformaInvoice {
  id              String         @id @default(cuid())
  number          String         @unique // RDS/PI/2026-27/0001
  customerId      String
  createdById     String
  quotationId     String?
  issueDate       DateTime
  validUntil      DateTime?
  status          ProformaStatus @default(DRAFT)
  // Advance
  advanceRequested Decimal?      @db.Decimal(12, 2)
  paymentTerms    String?
  // Totals
  subtotal        Decimal        @db.Decimal(12, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(12, 2)
  deliveryCharge  Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  notes           String?
  terms           String?
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer    Customer       @relation(fields: [customerId], references: [id])
  createdBy   User           @relation("ProformaCreator", fields: [createdById], references: [id])
  quotation   Quotation?     @relation("QuotationProformas", fields: [quotationId], references: [id])
  items       ProformaItem[]
  invoices    SalesInvoice[] @relation("ProformaInvoices")

  @@map("proforma_invoices")
}

model ProformaItem {
  id            String  @id @default(cuid())
  proformaId    String
  productId     String?
  description   String
  unit          String  @default("pcs")
  quantity      Decimal @db.Decimal(10, 3)
  unitPrice     Decimal @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  taxRate       Decimal @default(0) @db.Decimal(5, 2)
  lineTotal     Decimal @db.Decimal(12, 2)
  sortOrder     Int     @default(0)

  proforma ProformaInvoice @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  product  ProductService? @relation(fields: [productId], references: [id])

  @@map("proforma_items")
}

// ─────────────────────────────────────────────────────────────────────────────
//  SALES INVOICES
// ─────────────────────────────────────────────────────────────────────────────

model SalesInvoice {
  id              String        @id @default(cuid())
  number          String        @unique // RDS/INV/2026-27/0001
  customerId      String
  createdById     String
  quotationId     String?
  proformaId      String?
  orderId         String?
  issueDate       DateTime
  dueDate         DateTime
  status          InvoiceStatus @default(DRAFT)
  // Totals (snapshot at issue time)
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  deliveryCharge  Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  advancePaid     Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue      Decimal       @db.Decimal(12, 2)
  // Meta
  isWalkIn        Boolean       @default(false)
  walkInName      String?
  notes           String?
  terms           String?
  issuedAt        DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer       Customer          @relation(fields: [customerId], references: [id])
  createdBy      User              @relation("InvoiceCreator", fields: [createdById], references: [id])
  quotation      Quotation?        @relation("QuotationInvoices", fields: [quotationId], references: [id])
  proforma       ProformaInvoice?  @relation("ProformaInvoices", fields: [proformaId], references: [id])
  order          Order?            @relation(fields: [orderId], references: [id])
  items          InvoiceItem[]
  paymentAllocations PaymentAllocation[]

  @@map("sales_invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  unit        String  @default("pcs")
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoice SalesInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product ProductService? @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

// ─────────────────────────────────────────────────────────────────────────────
//  PAYMENTS & RECEIPTS
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique // RDS/REC/2026-27/0001
  customerId      String
  createdById     String
  paymentDate     DateTime
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  transactionRef  String?       // UPI ID / bank ref
  notes           String?
  isAdvance       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer    Customer            @relation(fields: [customerId], references: [id])
  createdBy   User                @relation("PaymentCreator", fields: [createdById], references: [id])
  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id          String   @id @default(cuid())
  paymentId   String
  invoiceId   String
  amount      Decimal  @db.Decimal(12, 2)
  allocatedAt DateTime @default(now())
  notes       String?

  payment Payment      @relation(fields: [paymentId], references: [id])
  invoice SalesInvoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@map("payment_allocations")
}

// ─────────────────────────────────────────────────────────────────────────────
//  GIFTING & PRINTING ORDERS
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id                  String      @id @default(cuid())
  number              String      @unique // RDS/ORD/2026-27/0001
  customerId          String
  createdById         String
  quotationId         String?
  orderDate           DateTime
  requiredByDate      DateTime?
  status              OrderStatus @default(NEW)
  // Customization details
  customizationNotes  String?
  designNotes         String?
  productionNotes     String?
  // Customer approval
  proofSentAt         DateTime?
  approvedAt          DateTime?
  approvedBy          String?
  // Costs
  estimatedCost       Decimal?    @db.Decimal(12, 2)
  actualCost          Decimal?    @db.Decimal(12, 2)
  // Payment
  advanceAmount       Decimal     @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal     @default(0) @db.Decimal(12, 2)
  // Delivery
  deliveryAddress     String?
  deliveryCity        String?
  deliveryPincode     String?
  deliveryCharge      Decimal     @default(0) @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  customer      Customer             @relation(fields: [customerId], references: [id])
  createdBy     User                 @relation("OrderCreator", fields: [createdById], references: [id])
  quotation     Quotation?           @relation("QuotationOrders", fields: [quotationId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  invoices      SalesInvoice[]
  deliveries    Delivery[]
  attachments   Attachment[]

  @@map("orders")
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  productId         String?
  description       String
  unit              String  @default("pcs")
  quantity          Decimal @db.Decimal(10, 3)
  unitPrice         Decimal @db.Decimal(12, 2)
  // Specifications
  size              String?
  material          String?
  color             String?
  specifications    String?
  estimatedCost     Decimal? @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(12, 2)
  sortOrder         Int      @default(0)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ProductService? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  updatedById String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  notes       String?
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  updatedBy User  @relation(fields: [updatedById], references: [id])

  @@map("order_status_history")
}

// ─────────────────────────────────────────────────────────────────────────────
//  DELIVERY MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

model Delivery {
  id                String         @id @default(cuid())
  orderId           String?
  customerId        String?
  recipientName     String
  recipientPhone    String
  address           String
  city              String?
  pincode           String?
  deliveryFee       Decimal        @default(0) @db.Decimal(12, 2)
  expectedDate      DateTime?
  dispatchDate      DateTime?
  deliveredDate     DateTime?
  courier           String?
  driverContact     String?
  trackingNumber    String?
  notes             String?
  proofPath         String?        // attachment
  status            DeliveryStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order    Order?    @relation(fields: [orderId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("deliveries")
}

// ─────────────────────────────────────────────────────────────────────────────
//  RECURRING BILLING
// ─────────────────────────────────────────────────────────────────────────────

model RecurringPlan {
  id               String              @id @default(cuid())
  customerId       String
  description      String
  monthlyFee       Decimal             @db.Decimal(12, 2)
  frequency        RecurringFrequency  @default(MONTHLY)
  billingDayOfMonth Int               @default(1) // 1–28
  startDate        DateTime
  endDate          DateTime?
  nextBillingDate  DateTime
  status           RecurringPlanStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  customer Customer         @relation(fields: [customerId], references: [id])
  runs     RecurringRun[]

  @@map("recurring_plans")
}

model RecurringRun {
  id            String   @id @default(cuid())
  planId        String
  periodStart   DateTime
  periodEnd     DateTime
  draftInvoiceId String? // links to the generated draft invoice
  generatedAt   DateTime?
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())

  plan RecurringPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, periodStart])
  @@map("recurring_runs")
}

// ─────────────────────────────────────────────────────────────────────────────
//  EXPENSES & SUPPLIERS
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  gstin     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@map("suppliers")
}

model Expense {
  id              String          @id @default(cuid())
  expenseNumber   String          @unique
  date            DateTime
  category        ExpenseCategory
  supplierId      String?
  description     String
  amount          Decimal         @db.Decimal(12, 2)
  method          PaymentMethod?
  transactionRef  String?
  receiptPath     String?
  relatedOrderId  String?
  notes           String?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  createdBy User      @relation("ExpenseCreator", fields: [createdById], references: [id])

  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────────────────────
//  FILE ATTACHMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Attachment {
  id          String               @id @default(cuid())
  entityType  AttachmentEntityType
  entityId    String
  filename    String
  originalName String
  mimeType    String
  sizeBytes   Int
  path        String               // server-side path, not public URL
  label       String?              // e.g. "Artwork", "Proof", "Receipt"
  uploadedById String?
  createdAt   DateTime             @default(now())

  // Polymorphic convenience relations (optional use)
  customer Customer? @relation(fields: [entityId], references: [id], map: "attachment_customer")
  order    Order?    @relation(fields: [entityId], references: [id], map: "attachment_order")

  @@map("attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
//  AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  entityType  String      // e.g. "Invoice", "Order", "Payment"
  entityId    String?
  description String
  metadata    Json?       // before/after snapshots as JSON
  ipAddress   String?
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
